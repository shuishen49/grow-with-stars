node_modules/
dist/
.env
.env.local
*.local
.DS_Store

# 第三方 AI 工具的本地计划/缓存（含明文密钥，不入库）
.zcode/
.zcodeignore
vite.config.ts.timestamp-*

# 安卓工程：只保留自己改过的部分，构建产物和签名不入库
android/.gradle/
android/build/
android/app/build/
android/app/release/
android/local.properties
android/.idea/
*.jks
*.keystore
# 例外：调试签名 keystore 要进仓库，否则每次打包签名都变、没法覆盖安装。
# 它只是调试版签名，不含任何机密。
!android/debug.keystore

# 构建时生成的版本号文件
.build_id
